NUXT_RECV_VERIFY_TOKEN=change-me
DATABASE_URL="postgresql://postgres:password@localhost:5432/gaupemail"

# --- Cloudflare Email Sending (POST /api/send) ---
# API token with the "Send Email" permission.
NUXT_CF_API_TOKEN=change-me
NUXT_CF_ACCOUNT_ID=change-me

# --- Passkeys / WebAuthn ---
# rpId = the hostname in the browser URL (no scheme, no port).
# origin = full origin including scheme (and port in dev).
NUXT_WEBAUTHN_RP_ID=localhost
NUXT_WEBAUTHN_RP_NAME=GaupeMail
NUXT_WEBAUTHN_ORIGIN=http://localhost:3000
